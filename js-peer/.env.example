# Optional escape hatch: dial these relay multiaddrs instead of asking the
# Aleph bootstrap channel. Leave it unset in normal use — relays rotate on
# every deploy, and a value pinned here silently outlives the relay behind it.
# That is what happened to the deployed build: an address baked in here kept
# winning over discovery long after its VM was gone, and libp2p refused to
# start at all.
# NEXT_PUBLIC_RELAY_LISTEN_ADDRS=/dns4/<host>/tcp/443/tls/ws/p2p/<peer-id>

# Optional: override the relay profile discovery scopes to (default: uc-go-peer)
# NEXT_PUBLIC_RELAY_BOOTSTRAP_PROFILE=uc-go-peer
